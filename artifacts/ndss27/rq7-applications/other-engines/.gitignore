# Build artifacts and scratch; sources, README and results/*.json are tracked.
__pycache__/
*.pyc
*.o
*.so
*.bin
*.elf
obj-intel64/
out.bin
*.stderr
*.stdout
*.log
results/*.stdout
results/*.log
_*_raw.json

# keep the per-tool verdicts, drop raw intermediate dumps
!results/*.json
results/_*_raw.json
# Guests and harnesses the detect_* drivers compile themselves.
ct_tg
dns_tg
obj-intel64/

# Prebuilt guests: the baselines' scripts hardcode addresses from these exact
# static binaries, so they are shipped (see prebuilt.sha256), not rebuilt.
